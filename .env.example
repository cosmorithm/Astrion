# 复制为 .env 后填写自己的模型配置。不要提交真实 key。
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash

# Optional context editing service. Empty keeps all five layers client-side.
# This is a separate HTTP service, not the model API base URL.
ASTRION_CONTEXT_SERVICE_URL=
ASTRION_CONTEXT_SERVICE_KEY=
ASTRION_CONTEXT_SERVICE_TIMEOUT=5
# Optional archive location for the core CLI (research archives follow its DB directory).
ASTRION_CONTEXT_DB=

# Research retrieval (independent of model API credentials)
ASTRION_EMBEDDING_BACKEND=none
ASTRION_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ASTRION_MODEL_CACHE=

# Literature search is independent of AGENT_BASE_URL / model credentials.
ASTRION_LITERATURE_BASE_URL=https://api.crossref.org
ASTRION_LITERATURE_EMAIL=
